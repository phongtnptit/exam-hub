generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  results      Result[]

  examAttempts ExamAttempt[]

  @@map("users")
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
  exams       Exam[]

  @@map("subjects")
}

model Question {
  id            Int      @id @default(autoincrement())
  subjectId     Int
  content       String   @db.Text
  optionA       String   @db.Text
  optionB       String   @db.Text
  optionC       String   @db.Text
  optionD       String   @db.Text
  correctAnswer String   @db.VarChar(1)
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject       Subject  @relation(fields: [subjectId], references: [id])
  examQuestions ExamQuestion[]

  @@index([subjectId])
  @@map("questions")
}

model Exam {
  id              Int        @id @default(autoincrement())
  subjectId       Int
  title           String
  description     String?    @db.Text
  durationMinutes Int
  status          ExamStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  subject         Subject        @relation(fields: [subjectId], references: [id])
  examQuestions   ExamQuestion[]
  results         Result[]

  examAttempts ExamAttempt[]
  
  @@index([subjectId])
  @@map("exams")
}

model ExamQuestion {
  id         Int @id @default(autoincrement())
  examId     Int
  questionId Int
  position   Int

  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@unique([examId, position])
  @@map("exam_questions")
}

model Result {
  id          Int      @id @default(autoincrement())
  userId      Int
  examId      Int
  attemptId   Int?     @unique
  answers     Json
  score       Float
  total       Int
  correct     Int
  startedAt   DateTime
  submittedAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id])
  exam    Exam         @relation(fields: [examId], references: [id])
  attempt ExamAttempt? @relation(fields: [attemptId], references: [id])

  @@index([userId])
  @@index([examId])
  @@map("results")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model ExamAttempt {
  id               Int           @id @default(autoincrement())
  userId           Int
  examId           Int
  status           AttemptStatus @default(IN_PROGRESS)
  activeKey        String?       @unique @db.VarChar(100)
  answers          Json?
  questionSnapshot Json?
  startedAt        DateTime      @default(now())
  expiresAt        DateTime
  submittedAt      DateTime?

  user   User    @relation(fields: [userId], references: [id])
  exam   Exam    @relation(fields: [examId], references: [id])
  result Result?

  @@index([userId, examId, status])
  @@map("exam_attempts")
}